    <Item class="Script">
        <Properties>
            <Name>Sound</Name>
            <UniqueHex>N/A</UniqueHex>
            <Source>
            <![CDATA[
local char = workspace.CharacterModel
local head = char.Head

local walkSound = Instance.new("Sound")
walkSound.SoundId = "lumisle://sounds/bfsl-minifigfoots1.mp3"
walkSound.Looped = true
walkSound.Parent = head

local jumpSound = Instance.new("Sound")
jumpSound.SoundId = "lumisle://sounds/swoosh.mp3"
jumpSound.Parent = head

local diedSound = Instance.new("Sound")
diedSound.SoundId = "lumisle://sounds/uuhhh.wav"
diedSound.Parent = head

while true do
    wait(0.1)
    
    if _G.isMoving and _G.isGrounded then
        if not walkSound.Playing then
            walkSound:Play()
        end
    else
        walkSound:Stop()
    end

    if _G.didJump then
        jumpSound:Play()
        _G.didJump = false
    end
    
    if _G.didDie then
        diedSound:Play()
        _G.didDie = false 
    end
end
]]>
            </Source>
            <Enabled>true</Enabled>
