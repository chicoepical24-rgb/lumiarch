    <Item class="Script">
    <Properties>
        <Name>Animate</Name>
        <UniqueHex>N/A</UniqueHex>
        <Source>
            <![CDATA[
local char = workspace.CharacterModel

local limbs = {
    LA = {part = char.LeftArm,  dir =  1},
    RA = {part = char.RightArm, dir = -1},
    LL = {part = char.LeftLeg,  dir = -1},
    RL = {part = char.RightLeg, dir =  1}
}

local stepPhase = 0

while true do
    task.wait(0.03)
    
    local amp, speed = 7.5, 0.02
    if not _G.isGrounded then
        for _, data in pairs(limbs) do
            local target = (data.part.Name:find("Arm")) and -180 or 0
            data.part.Orientation = data.part.Orientation:Lerp(Vector3.new(target, 0, 0), 0.2)
        end
        continue
    elseif _G.isMoving then
        amp, speed = 45, 0.12
    end

    stepPhase = stepPhase + speed
    local swing = math.sin(stepPhase) * amp

    for _, data in pairs(limbs) do
        data.part.Orientation = data.part.Orientation:Lerp(Vector3.new(swing * data.dir, 0, 0), 0.2)
    end
end
]]>
        </Source>
        <Enabled>true</Enabled>
